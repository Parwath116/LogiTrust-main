# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_string
JWT_SECRET=change_this_too
ADMIN_EMAIL=admin@logitrust.local
BOOTSTRAP_SECRET=your_bootstrap_secret_here

# --- IoT / Hardware Security ---
DEVICE_SECRET=logitrust_hardware_key_2026
GEOFENCE_RADIUS_M=500

# --- MQTT Broker ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=logitrust/telemetry/#

# --- Database (Postgres) ---
# Get a free instance from Neon, Supabase, or Railway if you don't have Postgres locally.
# Note: In docker-compose, this is automatically set to postgresql://postgres:password@db:5432/logitrust?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/logitrust"

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Blockchain (Sepolia) ---
# Get a free RPC URL from https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here
# Private key of the wallet that deploys/owns the contracts. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here
SHIPMENT_REGISTRY_ADDRESS=
SMART_ESCROW_ADDRESS=
# Conversion rate for INR to ETH: e.g. 250,000 INR = 1 ETH (or set TEST_ETH_SCALE)
INR_PER_ETH=250000
# TEST_ETH_SCALE=0.000004

# --- Email Notifications (Gmail SMTP) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- AI service & Anomaly Thresholds ---
AI_SERVICE_URL=http://localhost:8000
BREACH_CONSECUTIVE_COUNT=3
BREACH_WINDOW_MIN=15
AI_DISPUTE_THRESHOLD=80
