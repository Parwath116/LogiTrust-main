# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change_this_to_a_random_string
JWT_SECRET=change_this_too

# --- Database (Postgres) ---
# Get a free instance from Neon, Supabase, or Railway if you don't have Postgres locally.
DATABASE_URL="postgresql://user:password@localhost:5432/logitrust"

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Blockchain (Sepolia) ---
# Get a free RPC URL from https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here
# Private key of the wallet that deploys/owns the contracts. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here
SHIPMENT_REGISTRY_ADDRESS=
SMART_ESCROW_ADDRESS=

# --- AI service ---
AI_SERVICE_URL=http://localhost:8000
